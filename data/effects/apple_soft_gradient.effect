// Procedural soft animated multi-hue mesh — saturated overlapping blobs.
// No hash/noise (Metal-safe). Palette via color uniforms (a–e).

uniform float4x4 ViewProj;

uniform float2 resolution;
uniform float time;
uniform float speed;
uniform float intensity;
uniform float4 color_a;
uniform float4 color_b;
uniform float4 color_c;
uniform float4 color_d;
uniform float4 color_e;

struct VertData
{
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = v_in.uv;
	return vert_out;
}

float blob(float2 uv, float2 center, float radius, float softness)
{
	float d = length(uv - center) / max(radius, 0.001);
	return 1.0 - smoothstep(1.0 - softness, 1.0 + softness * 0.25, d);
}

float4 PSSoftGradient(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float t = time * max(speed, 0.0);
	float inten = saturate(intensity);

	float aspect = max(resolution.x, 1.0) / max(resolution.y, 1.0);
	float2 p = float2((uv.x - 0.5) * aspect, uv.y - 0.5);

	// Slow rotating under-field so hues drift across the frame
	float ang = t * 0.18;
	float ca = cos(ang);
	float sa = sin(ang);
	float2 pr = float2(p.x * ca - p.y * sa, p.x * sa + p.y * ca);
	float field_u = saturate(0.5 + pr.x * 0.55);
	float field_v = saturate(0.5 + pr.y * 0.55);
	float4 under =
		lerp(lerp(color_a, color_b, field_u),
		     lerp(color_c, color_d, field_u), field_v);
	under = lerp(under, color_e,
		     0.22 + 0.22 * sin(t * 0.22 + field_u * 3.14159));

	// Large travel amplitudes (~0.55–0.7) — clear regions of different hues
	float2 c0 = float2(sin(t * 0.29) * 0.62, cos(t * 0.25) * 0.55);
	float2 c1 = float2(cos(t * 0.21 + 1.7) * 0.68, sin(t * 0.33 + 0.9) * 0.58);
	float2 c2 = float2(sin(t * 0.17 + 2.4) * 0.55, cos(t * 0.27 + 1.3) * 0.66);
	float2 c3 = float2(cos(t * 0.31 + 0.4) * 0.70, sin(t * 0.19 + 2.1) * 0.52);
	float2 c4 = float2(sin(t * 0.24 + 3.1) * 0.48, cos(t * 0.36 + 0.6) * 0.60);

	float w0 = blob(p, c0, 0.78, 0.48);
	float w1 = blob(p, c1, 0.62, 0.42);
	float w2 = blob(p, c2, 0.88, 0.55);
	float w3 = blob(p, c3, 0.55, 0.38);
	float w4 = blob(p, c4, 0.70, 0.50);

	float wsum = w0 + w1 + w2 + w3 + w4 + 0.001;
	float4 wash = (color_a * w0 + color_b * w1 + color_c * w2 +
		       color_d * w3 + color_e * w4) /
		      wsum;

	// Prefer distinct blob colors; under-field fills gaps
	float blob_mix = 0.62 + 0.28 * inten;
	float4 base = lerp(under, wash, blob_mix);

	// Intensity boosts saturation and contrast (never mute toward gray)
	float luma = dot(base.rgb, float3(0.299, 0.587, 0.114));
	float sat_boost = 0.65 + 0.80 * inten;
	base.rgb = lerp(float3(luma, luma, luma), base.rgb, sat_boost);
	base.rgb = (base.rgb - 0.5) * (0.95 + 0.30 * inten) + 0.5;

	// Soft highlight breathing on dominant blobs
	float pulse = 0.5 + 0.5 * sin(t * 0.48);
	base.rgb += (0.025 + 0.045 * pulse) * inten * (w0 + w2) / wsum;

	base.rgb = saturate(base.rgb);
	base.a = 1.0;
	return base;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSSoftGradient(v_in);
	}
}
